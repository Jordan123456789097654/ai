# =============================================================================
# Kyro API — environment variable reference
# Copy to .env for local dev, or use .env.production.example for Render.
# =============================================================================

# Server
PORT=4000
NODE_ENV=development

# Postgres (Supabase)
# DATABASE_URL: app runtime (Transaction pooler, port 6543)
# DIRECT_URL: used only by `prisma migrate` (Session pooler, port 5432 —
#   transaction-mode pooling doesn't support the advisory locks migrations need)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Redis (docker-compose local / Render kyro-redis in prod)
REDIS_URL=redis://localhost:6379

# Supabase Auth — Project Settings → API
SUPABASE_URL=https://swzdndkvszotjausxdfk.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inference engine (vLLM / TGI / Ollama — anything OpenAI-compatible)
INFERENCE_BASE_URL=http://localhost:8000/v1
INFERENCE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
INFERENCE_API_KEY=

# Rate limiting defaults (requests per minute per tier)
RATE_LIMIT_FREE=20
RATE_LIMIT_PRO=120
RATE_LIMIT_ENTERPRISE=1000

# API key prefix
API_KEY_PREFIX=kyro_sk_live_

# Custom auth email delivery (Resend) — replaces Supabase Auth's built-in mailer
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Kyro <onboarding@resend.dev>
APP_URL=http://localhost:3000
