# =============================================================================
# Kyro API — environment variable reference
# Copy to .env for local dev, or use .env.production.example for Render.
# =============================================================================

# Server
PORT=4000
NODE_ENV=development

# Postgres (Supabase — Session pooler, port 5432)
DATABASE_URL=postgresql://postgres:4vKktG65oQYQlIop@db.hxehtjjzqiysfewpvvem.supabase.co:5432/postgres

# Redis (docker-compose local / Render kyro-redis in prod)
REDIS_URL=redis://localhost:6379

# Supabase Auth — Project Settings → API
SUPABASE_URL=https://hxehtjjzqiysfewpvvem.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq Cloud Inference Engine
INFERENCE_BASE_URL=https://api.groq.com/openai/v1
INFERENCE_MODEL=llama-3.3-70b-versatile

# ── Multi-Key Pool (recommended) ──────────────────────────────────────────────
# Add multiple Groq API keys separated by commas to distribute load across keys
# and automatically rotate to the next key on 429 rate-limit errors.
# Example: GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEYS=YOUR_GROQ_API_KEY_1,YOUR_GROQ_API_KEY_2

# Single-key fallback (used if GROQ_API_KEYS is not set)
INFERENCE_API_KEY=YOUR_GROQ_API_KEY

# Rate limiting defaults (requests per minute per tier)
RATE_LIMIT_FREE=20
RATE_LIMIT_PRO=120
RATE_LIMIT_ENTERPRISE=1000

# API key prefix
API_KEY_PREFIX=kyro_sk_live_
