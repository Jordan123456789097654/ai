# Server
PORT=4000
NODE_ENV=development

# Postgres (Prisma)
DATABASE_URL=postgresql://kyro:kyro_dev_password@localhost:5432/kyro

# Redis
REDIS_URL=redis://localhost:6379

# Supabase Auth — used to verify end-user session JWTs from the web app
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Inference engine (vLLM / TGI / Ollama — anything OpenAI-compatible)
INFERENCE_BASE_URL=http://localhost:8000/v1
INFERENCE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
INFERENCE_API_KEY=not-needed-for-self-hosted

# Rate limiting defaults (requests per minute), overridden per-tier below
RATE_LIMIT_FREE=20
RATE_LIMIT_PRO=120
RATE_LIMIT_ENTERPRISE=1000

# API key prefix
API_KEY_PREFIX=kyro_sk_live_
