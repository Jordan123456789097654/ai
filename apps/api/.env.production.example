# =============================================================================
# Kyro API — Render dashboard environment variables reference
# Set each of these in: Render dashboard → kyro-api → Environment
#
# Variables that Render auto-fills from its own services are noted below.
# All others must be typed in manually.
# =============================================================================

# Auto-filled by Render from the kyro-redis service:
REDIS_URL=<auto: fromService kyro-redis connectionString>

# ── Database ─────────────────────────────────────────────────────────────────
# Your Supabase Postgres connection strings.
# Supabase dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL: Transaction pooler (port 6543) — used by the running app.
#   postgresql://postgres.xxxx:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL: Session pooler (port 5432) — used ONLY by `prisma migrate deploy`.
#   Transaction-mode pooling (6543) doesn't support the advisory locks Prisma
#   migrations need, which causes `migrate deploy` to hang indefinitely rather
#   than fail — hence the separate direct/session connection just for migrations.
#   postgresql://postgres.xxxx:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.swzdndkvszotjausxdfk:bzOFNYiCXWnM7Qjn@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.swzdndkvszotjausxdfk:bzOFNYiCXWnM7Qjn@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# ── Supabase Auth ────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://swzdndkvszotjausxdfk.supabase.co
SUPABASE_ANON_KEY=<from Supabase dashboard → Project Settings → API → anon public>
SUPABASE_JWT_SECRET=<from Supabase dashboard → Project Settings → API → JWT Secret>
SUPABASE_SERVICE_ROLE_KEY=<from Supabase dashboard → Project Settings → API → service_role secret>

# ── Inference Engine ─────────────────────────────────────────────────────────
INFERENCE_BASE_URL=http://YOUR_GPU_HOST:8000/v1
INFERENCE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
INFERENCE_API_KEY=

# ── Auto-set in render.yaml (no need to set manually) ────────────────────────
PORT=4000
NODE_ENV=production
API_KEY_PREFIX=kyro_sk_live_
RATE_LIMIT_FREE=20
RATE_LIMIT_PRO=120
RATE_LIMIT_ENTERPRISE=1000

# ── Custom auth email delivery (Resend) ──────────────────────────────────────
# Replaces Supabase Auth's built-in mailer. Get a key at https://resend.com/api-keys
# EMAIL_FROM must use a domain you've verified in Resend once you're past testing
# with the shared onboarding@resend.dev sender (which only delivers to your own
# Resend account email).
RESEND_API_KEY=<from Resend dashboard → API Keys>
EMAIL_FROM=Kyro <onboarding@resend.dev>
# Your deployed web app's public URL — used to build magic-link/confirmation redirects
APP_URL=https://your-web-app.onrender.com
