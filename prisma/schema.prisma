generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum Tier {
  free
  pro
  enterprise
}

model User {
  id           String   @id @default(uuid()) // matches Supabase auth.users.id
  email        String   @unique
  role         Role     @default(user)
  tier         Tier     @default(free)
  isSuspended  Boolean  @default(false) @map("is_suspended")
  createdAt    DateTime @default(now()) @map("created_at")

  apiKeys       ApiKey[]
  conversations Conversation[]

  @@map("users")
}

model ApiKey {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  keyHash           String   @unique @map("key_hash")   // sha256 of the raw secret
  keyPrefix         String   @map("key_prefix")          // e.g. kyro_sk_live_7f3a — shown in the UI
  rateLimitOverride Int?     @map("rate_limit_override")  // requests/min override, null = use tier default
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  lastUsedAt        DateTime? @map("last_used_at")

  usageLogs ApiUsageLog[]

  @@index([userId])
  @@map("api_keys")
}

model ApiUsageLog {
  id               String   @id @default(uuid())
  apiKeyId         String   @map("api_key_id")
  apiKey           ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint         String
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  statusCode       Int      @default(200) @map("status_code")
  latencyMs        Int?     @map("latency_ms")
  timestamp        DateTime @default(now())

  @@index([apiKeyId, timestamp])
  @@map("api_usage_logs")
}

model SystemConfig {
  id                 String   @id @default(uuid())
  activeModel        String   @map("active_model")
  globalSystemPrompt String   @map("global_system_prompt") @db.Text
  defaultTemperature Float    @default(0.7) @map("default_temperature")
  defaultTopP        Float    @default(1.0) @map("default_top_p")
  defaultMaxTokens   Int      @default(1024) @map("default_max_tokens")
  isActive           Boolean  @default(false) @map("is_active") // exactly one row should be true
  updatedAt          DateTime @updatedAt @map("updated_at")
  updatedBy          String?  @map("updated_by") // admin user id

  @@map("system_configs")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New chat")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user" | "assistant" | "system"
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}
